# ------------------------------------------------------------------
# ENVIROGRID 2.0 — Environment Variables
# Copy to .env for local dev. Values read by the browser MUST use the VITE_ prefix.
# ------------------------------------------------------------------

# Supabase (create project at https://supabase.com, enable PostGIS)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAQ API v3 key (https://docs.openaq.org)
VITE_OPENAQ_API_KEY=your_openaq_api_key

# NASA FIRMS Map Key (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
VITE_NASA_FIRMS_MAP_KEY=your_nasa_firms_key

# LLM provider key (Gemini: https://aistudio.google.com/apikey)
VITE_LLM_API_KEY=your_gemini_or_openai_api_key
VITE_LLM_PROVIDER=gemini

# Optional: Open-Meteo / GBIF / Wikipedia are keyless.

# ------------------------------------------------------------------
# Vercel production deployment
# ------------------------------------------------------------------
# Add these in the Vercel dashboard (Settings -> Environment Variables).
# The serverless functions in /api inject them, so they never ship to the
# browser. They fall back to the VITE_ prefixed values above if unset.
#   1. VITE_* keys above (browser bundle)
#   2. LLM_API_KEY=your_gemini_key          (used by api/gemini.ts)
#   3. OPENAQ_API_KEY=your_openaq_key       (used by api/openaq.ts)
#   4. NASA_FIRMS_MAP_KEY=your_firms_key    (used by api/firms.ts)
#   5. VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY for client-side Supabase
#
# Build command: npm run build (auto-detected) — output: dist/
