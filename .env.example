# ------------------------------------------------------------------
# ENVIROGRID 2.0 — Environment Variables
# Copy to .env and fill in your keys.
# NOTE: values read by the browser MUST use the VITE_ prefix.
# ------------------------------------------------------------------

# Supabase (create project at https://supabase.com, enable PostGIS)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side only. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAQ API v3 key (https://docs.openaq.org)
VITE_OPENAQ_API_KEY=your_openaq_api_key

# NASA FIRMS Map Key (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
VITE_NASA_FIRMS_MAP_KEY=your_nasa_firms_key

# LLM provider key (Gemini: https://aistudio.google.com/apikey)
VITE_LLM_API_KEY=your_gemini_or_openai_api_key
VITE_LLM_PROVIDER=gemini

# Optional: Open-Meteo / GBIF / Wikipedia are keyless.
